# Credentials for the end-to-end tests. Copy to .env.e2e and fill in.
#
#   cp .env.e2e.example .env.e2e
#
# .env.e2e is gitignored. Nothing reads these but Playwright, and they are
# never written to a report or a log.
#
# Use the SANDBOX project's accounts, not a client's. These tests approve
# enrollments, sign dogs in and retire dogs.

# A staff account that can approve enrollments and open a dog profile.
E2E_STAFF_USERNAME=
E2E_STAFF_PASSWORD=

# The lobby iPad's account — the one with the `kiosk` role.
E2E_KIOSK_USERNAME=
E2E_KIOSK_PASSWORD=

# Where the dev server is listening. It picks its own port when 3000 is
# taken, so paste whatever `npm run dev` printed.
E2E_BASE_URL=http://localhost:3000
